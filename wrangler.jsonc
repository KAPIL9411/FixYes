{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixyes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGINS": "http://localhost:8081,http://localhost:3000",
    "GOOGLE_CLIENT_IDS": "",
    "REALTIME_URL_BASE": ""
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BOOKING_ROOM", "class_name": "BookingRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BookingRoom"] }
  ]
}
