# Local development only. Copy this file to .dev.vars and fill in values.
# Never commit real secrets.

DATABASE_URL=
# Comma-separated Google OAuth client IDs: web, iOS, Android. Never a client secret.
GOOGLE_CLIENT_IDS=
APP_ORIGINS=http://localhost:8081,http://localhost:3000
ENVIRONMENT=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configure Expo push security server-side; no client secrets here.
# Expo push is disabled while this is empty.
EXPO_ACCESS_TOKEN=

# HMAC key for realtime WebSocket tickets. Production value comes from
# `wrangler secret put REALTIME_TICKET_SECRET` (at least 32 characters).
# Realtime is disabled while this is empty.
REALTIME_TICKET_SECRET=
# Optional public origin used to build websocketUrl, e.g. https://api.example.com.
# Leave empty to derive it from the incoming request.
REALTIME_URL_BASE=
